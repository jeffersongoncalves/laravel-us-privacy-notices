{
    "name": "jeffersongoncalves/laravel-us-privacy-notices",
    "description": "Privacy notice for the US state privacy laws: processing activities, the disclosures every state requires, rights and appeals, and the Your Privacy Choices link",
    "keywords": [
        "laravel",
        "privacy",
        "us-privacy",
        "privacy-notice",
        "privacy-policy"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-us-privacy-notices",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "jeffersongoncalves/laravel-us-privacy": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "jeffersongoncalves/pest-plugin-database-migrations": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\UsPrivacyNotices\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\UsPrivacyNotices\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\UsPrivacyNotices\\UsPrivacyNoticesServiceProvider"
            ],
            "aliases": {
                "UsPrivacyNotices": "JeffersonGoncalves\\UsPrivacyNotices\\Facades\\UsPrivacyNotices"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
